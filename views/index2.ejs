<!DOCTYPE html>
<html>
<head>
  <title>WhatsApp Control Panel</title>
</head>
<body>
<h1>Connected Devices</h1>


<ul>
    <% if (devices && devices.length > 0) { %>
        <% devices.forEach(function(sessionName) { %>
            <li>
                <strong>Session Name:</strong> <%= sessionName %><br>

                <!-- Form for Deleting the session -->
                <form action="/control/delete" method="POST" style="display:inline;" target="_blank" onsubmit="handleSessionCreate(event)" >
                    <input type="hidden" name="session" value="<%= sessionName %>" />
                    <button type="submit">Delete</button>
                </form>

                <!-- Form for Sending Message to the session -->
                <form action="/control/send-message" method="POST" style="display:inline; margin-left: 10px;" target="_blank">
                    <input type="hidden" name="instance_id" value="<%= sessionName %>" />
                    <input type="hidden" name="access_token" value="<%= token %>" />
                    <input type="text" name="number" placeholder="Enter receiver number" required />
                    <input type="text" name="message" placeholder="Enter your message" required />
                    <button type="submit">Send</button>
                </form>
                <button type="button" onclick="getGroups('<%= sessionName %>', '<%= token %>')" style="margin-left: 10px;">Get Groups</button>

            </li>
        <% }) %>
    <% } else { %>
        <li>No sessions connected</li>
    <% } %>
</ul>


<h2>Create New Session</h2>
<form action="/control/create" method="POST" target="_blank" onsubmit="handleSessionCreate(event)">
  <label for="session">Session Name:</label>
  <input type="text" name="session" required>
  <button type="submit">Create Session</button>
</form>

<!-- Modal for displaying groups -->
<div id="groupsModal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
  <div style="background:#fff; max-width:500px; width:90vw; max-height:80vh; overflow-y:auto; margin:auto; padding:20px; border-radius:8px; position:relative;">
    <button onclick="closeGroupsModal()" style="position:absolute; top:10px; right:10px;">&times;</button>
    <h3>Groups</h3>
    <div id="groupsList"></div>
  </div>
</div>

<script>
    function handleSessionCreate(event) {
        setTimeout(() => {
            location.reload(); // Refresh the current page after a short delay
        }, 1000); // Adjust delay as needed (1 second here)
    }

    function getGroups(instanceId, token) {
        fetch('/groups', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ instance_id: instanceId, access_token: token })
        })
        .then(response => response.json())
        .then(data => {
            if (data && data.data && Array.isArray(data.data)) {
                showGroupsModal(data.data);
            } else {
                alert('No groups found or error in response');
            }
        })
        .catch(err => {
            alert('Error fetching groups: ' + err);
        });
    }

    function showGroupsModal(groups) {
        const modal = document.getElementById('groupsModal');
        const list = document.getElementById('groupsList');
        if (!groups.length) {
            list.innerHTML = '<p>No groups found.</p>';
        } else {
            list.innerHTML = groups.map(g => `
                <div style="border-bottom:1px solid #eee; padding:8px 0; display:flex; align-items:center; justify-content:space-between;">
                  <div>
                    <strong>${g.name || '(no name)'}</strong><br>
                    <span style="font-size:12px; color:#555;">ID: <span id="gid-${g.id}">${g.id}</span></span>
                  </div>
                  <button onclick="copyGroupId('${g.id}')" style="margin-left:10px;">Copy</button>
                </div>
            `).join('');
        }
        modal.style.display = 'flex';
    }

    function closeGroupsModal() {
        document.getElementById('groupsModal').style.display = 'none';
    }

    function copyGroupId(id) {
        const el = document.createElement('textarea');
        el.value = id;
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
        alert('Group ID copied!');
    }
</script>
</body>
</html>
